{
  "manifest_version": 3,
  "name": "presidio-fr shield",
  "version": "0.2.0",
  "description": "Masque les données personnelles françaises (noms, adresses, NIR, SIRET, IBAN, e-mail…) avant l'envoi à ChatGPT, et les restaure dans la réponse. Tout se passe dans votre navigateur.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/recognizers.js", "src/vault.js", "src/nermap.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "presidio-fr shield" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
